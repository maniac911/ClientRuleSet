{
  "routing": {
    "rules": [
      {
        "type": "field",
        "outboundTag": "proxy",
        "ruleTag": "ClientRuleSet non_ip/stream_eu",
        "domain": [
          "domain:itv.com",
          "domain:bbc.co.uk",
          "domain:bbci.co.uk",
          "full:bbc.mp-pxcdn.com",
          "domain:tvlicensing.co.uk",
          "full:itvpnpmobile-a.akamaihd.net",
          "keyword:bbcfmt",
          "keyword:uk-live"
        ]
      },
      {
        "type": "field",
        "outboundTag": "proxy",
        "ruleTag": "ClientRuleSet non_ip/stream_eu",
        "attrs": {
          "user-agent": "^ITV_Player.*$"
        }
      },
      {
        "type": "field",
        "outboundTag": "proxy",
        "ruleTag": "ClientRuleSet non_ip/stream_eu",
        "attrs": {
          "user-agent": "^BBCiPlayer.*$"
        }
      }
    ]
  }
}
